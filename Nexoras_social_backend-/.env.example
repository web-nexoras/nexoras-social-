PORT=5000
BASE_URL=/api/v1
NODE_ENV=development
DB_URL=mongodb://127.0.0.1:27017/your_database_name
JWT_SEC=replace_with_a_long_random_access_secret
JWT_REFRESH_SEC=replace_with_a_different_long_random_refresh_secret
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
CLIENT_URL=http://localhost:3000

# --------cloudinary configuration
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret


# --------auth0 configuration
AUTH0_DOMAIN=your-domain-name.come
AUTH0_CLIENT_ID=your_auth0_spa_client_id
AUTH0_CLIENT_SECRET=your_auth0_spa_client_secret
AUTH0_AUDIENCE=your_auth0_api_audience


# --------redis configuration
REDIS_ENABLED=true
REDIS_URL=redis://default:your_redis_password@your_redis_host:your_redis_port

# Required for verification and password reset emails.
# nodemailer email info
# EMAIL_USER=mahirthecoder.bd@gmail.com
# EMAIL_PASS=acggrmko tyze jshm 


# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=bc6509001@smtp-brevo.com

# --------email service provider (brevo) configuration
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM="Your App Name" <your_email@example.com>


# --------ssl configuration
SSL_STORE_ID=your_ssl_store_id
SSL_STORE_PASSWORD=your_ssl_store_password
SSL_IS_LIVE=false
SSL_SUCCESS_URL=your_success_url
SSL_FAIL_URL=your_fail_url
SSL_CANCEL_URL=your_cancel_url

